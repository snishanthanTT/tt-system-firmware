/*
 * SPI test overlay for dm_test_app - nucleo_u385rg_q board only
 */
&spi1 {
	max7221: max7221@0 {
		compatible = "maxim,max7219";
		reg = <0>;
		spi-max-frequency = <1000000>;
		num-cascading = <1>;
		intensity = <8>;
		scan-limit = <7>;
	};
};

&i3c1 {
	pinctrl-0 = <&i3c1_scl_pb2 &i3c1_sda_pc1>;
	pinctrl-names = "default";
	status = "okay";
	i3c-scl-hz = <1000000>;   /* 1 MHz I3C frequency */
	i2c-scl-hz = <400000>;    /* 400 kHz I2C Fast Mode */
	target-mode;
	mipi-instance = <0x8>;
};

/*
 * OCCP target emulator, second link: i2c1 as an I2C target at 0x55 (address
 * set at runtime by the app). The board file already routes it to PB6 (SCL)
 * and PB7 (SDA), Arduino D15 / D14 on a rev D board. The controller sets the
 * bus speed; clock-frequency only shapes the target's filters and hold times.
 */
&i2c1 {
	clock-frequency = <I2C_BITRATE_FAST>;
};

/*
 * i2c2 is the Arduino I2C on a rev E board (PB13 / PB14). The emulator
 * answers on it too, so the header pins work whatever the board revision.
 * It shares PB14 with i3c2 below, which the emulator does not use.
 */
&i2c2 {
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i3c2 {
	pinctrl-0 = <&i3c2_scl_pb10 &i3c2_sda_pb14>;
	pinctrl-names = "default";
	/* Off on the OCCP target bench: PB14 belongs to i2c2 there. */
	status = "disabled";
	i3c-scl-hz = <1000000>;   /* 1 MHz I3C frequency */
	i2c-scl-hz = <400000>;    /* 400 kHz I2C Fast Mode */

	i3c2_smc_remoteproc: smc_remoteproc@20813818000 {
		compatible = "tenstorrent,smc-remoteproc";
		reg = <0x0000 0x0208 0x13818000>;
		/* Its bus is off on this bench, see i3c2 above. */
		status = "disabled";
	};
};

/*
 * OCCP target emulator: let the I3C target interrupt preempt the console.
 *
 * Every peripheral defaults to interrupt priority 0, so an in-progress UART or
 * USB interrupt delays the I3C one. The STM32 I3C RX FIFO is 4 bytes deep and a
 * 1 MHz write fills it in about 36 us; a busy console ISR was enough to overrun
 * it (measured 2026-09-10: back-to-back 256-byte OCCP reads with per-command
 * logging on lost bytes of the next write and NACKed the reply). i3c1 stays at
 * 0; the console and USB drop to 2.
 */
&usart1 {
	interrupts = <0x3d 2>;
};

&usb {
	interrupts = <0x49 2>;
};
